[gd_scene format=3]

[ext_resource type="Script" path="res://Scenes/IntroCrawl.gd" id="1_intro"]
[ext_resource type="AudioStream" path="res://Music/Star Wars (1977) original opening crawl - (original Kbps).mp3" id="2_music"]

[sub_resource type="Shader" id="Shader_crawl"]
code = "shader_type canvas_item;

void fragment() {
	float t = clamp((UV.y - 0.08) / 0.92, 0.0, 1.0);
	float depth = mix(2.4, 0.95, t);
	float sample_x = (UV.x - 0.5) * depth + 0.5;
	float sample_y = pow(t, 0.72);

	if (sample_x < 0.0 || sample_x > 1.0 || UV.y < 0.08) {
		COLOR = vec4(0.0);
	} else {
		vec4 tex = texture(TEXTURE, vec2(sample_x, sample_y));
		float fade_top = smoothstep(0.08, 0.32, UV.y);
		float fade_bottom = smoothstep(1.0, 0.90, UV.y);
		COLOR = vec4(tex.rgb, tex.a * fade_top * fade_bottom);
	}
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_crawl"]
shader = SubResource("Shader_crawl")

